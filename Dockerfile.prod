FROM node:24.22.1-slim

WORKDIR /app

ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_COLLECTEXPRESS
ARG NEXT_PUBLIC_COLLECTEXPRESS_URL
ARG NEXT_PUBLIC_FRONTENDURL
ARG NEXT_PUBLIC_NODE_ENV=production

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_COLLECTEXPRESS=$NEXT_PUBLIC_COLLECTEXPRESS
ENV NEXT_PUBLIC_COLLECTEXPRESS_URL=$NEXT_PUBLIC_COLLECTEXPRESS_URL
ENV NEXT_PUBLIC_FRONTENDURL=$NEXT_PUBLIC_FRONTENDURL
ENV NEXT_PUBLIC_NODE_ENV=$NEXT_PUBLIC_NODE_ENV

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

ENV NODE_ENV=production
ENV PORT=3001
EXPOSE 3001

CMD ["npm", "start"]
