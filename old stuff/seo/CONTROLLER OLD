      defaultRobots: "",
      defaultLanguage: "",
    } */

  const {
    defaultTitle,
    defaultDescription,
    siteName,
    defaultCanonicalBase,
    twitterCardType,
    defaultRobots,
    defaultLanguage,
  } = req.body;

  const imageFile = req.file?.filename;
  let uploadpathANndimagepath;
  if (imageFile) {
    uploadpathANndimagepath = "public/images/seouploads/" + imageFile;
    console.log("Image file received:", imageFile);
  }

  const collection = db.collection("sitewideSEO");

  try {
    const insertsidewideSEO = await collection.updateOne(
      { id1: "sitewideSEO" }, // Assuming you want to update a single document with this ID
      {
        $set: {
          defaultTitle,
          defaultDescription,
          siteName,
          defaultCanonicalBase,
          twitterCardType,
          defaultRobots,
          defaultLanguage,
          image: uploadpathANndimagepath, // Store the path to the uploaded image
        },
      },
      { upsert: true } // Create the document if it doesn't exist
    );
    if (!insertsidewideSEO.acknowledged) {
      console.error("Failed to save site-wide SEO settings.");
      return res
        .status(500)
        .json({ error: "Failed to save site-wide SEO settings." });
    }
    console.log(
      "Site-wide SEO settings saved successfully:",
      insertsidewideSEO
    );
    // Optionally, you can return the updated document or a success message
    res
      .status(200)
      .json({ message: "Site-wide SEO settings saved successfully." });
  } catch {
    console.error("Error saving site-wide SEO settings:", error);
    return res
      .status(500)
