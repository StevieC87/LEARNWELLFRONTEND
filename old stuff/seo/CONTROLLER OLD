// THERE IS NO SUCH THING AS SITE WIDE SEO CONTENT
export const getsitewideSEO = async (req, res) => {
  const db = getDb();
  console.log("Fetching site-wide SEO settings...");
  const collection = db.collection("sitewideSEO");

  try {
    const sitewideSEO = await collection.findOne({ id1: "sitewideSEO" });
    if (!sitewideSEO) {
      console.error("No site-wide SEO settings found.");
      return res
        .status(404)
        .json({ error: "No site-wide SEO settings found." });
    }
    console.log("Site-wide SEO settings fetched successfully:", sitewideSEO);
    res.status(200).json(sitewideSEO);
  } catch (error) {
    console.error("Error fetching site-wide SEO settings:", error);
    return res
      .status(500)
      .json({ error: "Failed to fetch site-wide SEO settings." });
  }
};

export const savesitewideSEO = async (req, res) => {
  const db = getDb();
  console.log("Saving site-wide SEO settings...");
  /*  defaultValues: {
      defaultTitle: "",
